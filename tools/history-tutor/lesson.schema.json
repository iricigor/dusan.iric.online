{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone Czech history lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "topic", "audience", "review", "sources", "original", "corrections", "glossary", "chunks", "questions"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "review": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      }
    },
    "original": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["heading", "text"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section", "quote", "explanation", "sourceUrl"],
        "properties": {
          "section": { "type": "integer", "minimum": 0 },
          "quote": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "pattern": "^https://[^\\s]+$" }
        }
      }
    },
    "glossary": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term", "definition", "forms"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "forms": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "chunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["heading", "sentences", "explanation"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "sentences": {
            "type": "array", "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions": {
      "type": "array", "minItems": 10, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "difficulty", "type", "prompt", "explanation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "type": { "enum": ["trueFalse", "choice", "text"] },
          "prompt": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "answer": { "type": "integer", "minimum": 0 },
          "acceptedAnswers": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "year": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "difficulty": { "const": "easy" } } },
            "then": {
              "required": ["options", "answer"],
              "properties": {
                "type": { "const": "trueFalse" },
                "options": { "const": ["Pravda", "Nepravda"] },
                "answer": { "maximum": 1 }
              },
              "not": { "anyOf": [{ "required": ["acceptedAnswers"] }, { "required": ["year"] }] }
            }
          },
          {
            "if": { "properties": { "difficulty": { "const": "medium" } } },
            "then": {
              "required": ["options", "answer"],
              "properties": {
                "type": { "const": "choice" },
                "options": { "minItems": 4, "maxItems": 4 },
                "answer": { "maximum": 3 }
              },
              "not": { "anyOf": [{ "required": ["acceptedAnswers"] }, { "required": ["year"] }] }
            }
          },
          {
            "if": { "properties": { "difficulty": { "const": "hard" } } },
            "then": {
              "required": ["acceptedAnswers", "year"],
              "properties": { "type": { "const": "text" } },
              "not": { "anyOf": [{ "required": ["options"] }, { "required": ["answer"] }] }
            }
          },
          {
            "if": { "required": ["year"], "properties": { "year": { "const": true } } },
            "then": {
              "properties": {
                "acceptedAnswers": {
                  "maxItems": 1,
                  "items": { "type": "string", "pattern": "^[1-9][0-9]{0,3}$" }
                }
              }
            }
          }
        ]
      }
    }
  }
}
