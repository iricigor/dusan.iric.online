{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared Czech tutor lessons: history v3 and progressive maths v4 (legacy v1/v2/v3 support)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "topic", "audience", "original", "glossary"],
  "properties": {
    "version": { "enum": [1, 2, 3, 4] },
    "subject": { "enum": ["history", "maths"] },
    "language": { "const": "cs-CZ" },
    "id": { "$ref": "#/$defs/id" },
    "topic": { "$ref": "#/$defs/text" },
    "subtitle": { "$ref": "#/$defs/text" },
    "audience": { "$ref": "#/$defs/text" },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["target", "quote", "color"],
        "properties": {
          "target": { "$ref": "#/$defs/text" },
          "quote": { "$ref": "#/$defs/text" },
          "color": { "enum": ["yellow", "blue", "green"] }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["chunk", "year", "label"],
        "properties": {
          "chunk": { "type": "integer", "minimum": 0 },
          "year": { "type": "integer", "minimum": -9999, "maximum": 9999 },
          "label": { "$ref": "#/$defs/text" },
          "lifespan": {
            "type": "object", "additionalProperties": false, "required": ["birth", "death"],
            "properties": {
              "birth": { "type": "integer", "minimum": -9999, "maximum": 9999 },
              "death": { "type": "integer", "minimum": -9999, "maximum": 9999 }
            }
          }
        }
      }
    },
    "original": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["heading", "text"],
        "properties": {
          "heading": { "$ref": "#/$defs/text" },
          "icon": { "$ref": "#/$defs/icon" },
          "text": { "$ref": "#/$defs/text" },
          "style": { "$ref": "#/$defs/originalStyle" },
          "paragraphs": { "$ref": "#/$defs/originalParagraphs" }
        }
      }
    },
    "glossary": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["term", "definition", "forms"],
        "properties": {
          "term": { "$ref": "#/$defs/text" },
          "icon": { "$ref": "#/$defs/icon" },
          "definition": { "$ref": "#/$defs/text" },
          "forms": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "review": { "$ref": "#/$defs/text" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "url"],
        "properties": { "title": { "$ref": "#/$defs/text" }, "url": { "$ref": "#/$defs/url" } }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section", "quote", "explanation", "sourceUrl"],
        "properties": {
          "section": { "type": "integer", "minimum": 0 },
          "quote": { "$ref": "#/$defs/text" },
          "explanation": { "$ref": "#/$defs/text" },
          "sourceUrl": { "$ref": "#/$defs/url" }
        }
      }
    },
    "chunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["heading", "sentences", "explanation"],
        "properties": {
          "heading": { "$ref": "#/$defs/text" },
          "icon": { "$ref": "#/$defs/icon" },
          "sentences": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
          "explanation": { "$ref": "#/$defs/text" },
          "paragraphs": { "$ref": "#/$defs/paragraphs" }
        }
      }
    },
    "questions": { "type": "array", "minItems": 10, "maxItems": 100, "items": { "$ref": "#/$defs/historyQuestion" } },
    "examples": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "heading", "prompt", "hint", "steps", "answer"],
        "properties": {
          "kind": { "enum": ["simple", "complex", "everyday", "challenge"] },
          "heading": { "$ref": "#/$defs/text" },
          "icon": { "$ref": "#/$defs/icon" },
          "prompt": { "$ref": "#/$defs/text" },
          "hint": { "$ref": "#/$defs/text" },
          "answer": { "$ref": "#/$defs/text" },
          "paragraphs": { "$ref": "#/$defs/paragraphs" },
          "steps": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["calculation", "explanation"],
              "properties": { "calculation": { "$ref": "#/$defs/text" }, "explanation": { "$ref": "#/$defs/text" } }
            }
          }
        }
      }
    },
    "exercises": { "type": "array", "minItems": 10, "maxItems": 100 }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 3 } } },
      "then": {
        "required": ["subject", "language", "subtitle"],
        "properties": {
          "questions": { "items": { "required": ["assessment"] } },
          "exercises": { "items": { "$ref": "#/$defs/mathsExercise", "properties": { "steps": { "items": { "required": ["assessment"] } } } } }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": 4 } } },
      "then": {
        "required": ["subject", "language", "subtitle"],
        "properties": {
          "subject": { "const": "maths" },
          "exercises": { "items": { "$ref": "#/$defs/progressiveMathsExercise" } }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": 1 } } },
      "then": { "properties": {
        "subject": { "const": "history" },
        "questions": { "items": { "not": { "required": ["assessment"] } } }
      } }
    },
    {
      "if": { "properties": { "version": { "const": 2 } } },
      "then": { "required": ["subject", "language"], "properties": {
        "subject": { "const": "maths" },
        "exercises": { "items": { "$ref": "#/$defs/mathsExercise", "properties": { "steps": { "items": { "not": { "required": ["assessment"] } } } } } }
      } }
    },
    {
      "if": { "required": ["subject"], "properties": { "subject": { "const": "maths" } } },
      "then": {
        "required": ["examples", "exercises"],
        "not": { "anyOf": [
          { "required": ["review"] }, { "required": ["sources"] }, { "required": ["corrections"] },
          { "required": ["chunks"] }, { "required": ["questions"] }, { "required": ["timeline"] }
        ] }
      },
      "else": {
        "required": ["review", "sources", "corrections", "chunks", "questions"],
        "not": { "anyOf": [{ "required": ["examples"] }, { "required": ["exercises"] }] }
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "minLength": 1, "maxLength": 32 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "numericValue": { "type": "string", "minLength": 1, "maxLength": 80 },
    "numberMatcher": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": { "type": { "const": "number" }, "value": { "$ref": "#/$defs/numericValue" } }
    },
    "stringMatcher": {
      "type": "object", "additionalProperties": false, "required": ["type", "value"],
      "properties": {
        "type": { "const": "string" },
        "value": { "type": "string", "minLength": 1, "maxLength": 80 },
        "normalization": { "enum": ["literal", "czech"] }
      }
    },
    "rangeMatcher": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "min", "max", "includeMin", "includeMax"],
      "properties": {
        "type": { "const": "range" },
        "min": { "$ref": "#/$defs/numericValue" }, "max": { "$ref": "#/$defs/numericValue" },
        "includeMin": { "type": "boolean" }, "includeMax": { "type": "boolean" }
      }
    },
    "atomicMatcher": {
      "anyOf": [
        { "$ref": "#/$defs/numberMatcher" }, { "$ref": "#/$defs/stringMatcher" }, { "$ref": "#/$defs/rangeMatcher" }
      ]
    },
    "matcher": {
      "anyOf": [
        { "$ref": "#/$defs/atomicMatcher" },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "items"],
          "properties": {
            "type": { "const": "array" },
            "items": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/atomicMatcher" } }
          }
        }
      ]
    },
    "assessment": {
      "type": "object", "additionalProperties": false, "required": ["input", "exact"],
      "properties": {
        "input": { "enum": ["text", "number", "length"] },
        "unit": { "enum": ["mm", "cm", "dm", "m", "km"] },
        "exact": { "$ref": "#/$defs/matcher" },
        "partial": {
          "type": "object", "additionalProperties": false, "required": ["match", "credit"],
          "properties": { "match": { "$ref": "#/$defs/matcher" }, "credit": { "const": 0.5 } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "input": { "const": "length" } } },
          "then": { "required": ["unit"] },
          "else": { "not": { "required": ["unit"] } }
        }
      ]
    },
    "style": { "enum": ["plain", "note", "example", "tip", "warning", "comment", "fun", "quote"] },
    "originalStyle": { "anyOf": [{ "$ref": "#/$defs/style" }, { "const": "important" }] },
    "originalParagraphs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["style", "text"],
        "properties": { "style": { "$ref": "#/$defs/originalStyle" }, "text": { "$ref": "#/$defs/text" } }
      }
    },
    "paragraphs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["style", "text"],
        "properties": { "style": { "$ref": "#/$defs/style" }, "text": { "$ref": "#/$defs/text" } }
      }
    },
    "historyQuestion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "difficulty", "type", "prompt", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "icon": { "$ref": "#/$defs/icon" },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "type": { "enum": ["trueFalse", "choice", "text"] },
        "prompt": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "options": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "answer": { "type": "integer", "minimum": 0 },
        "acceptedAnswers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "year": { "type": "boolean" },
        "assessment": { "$ref": "#/$defs/assessment" }
      },
      "allOf": [
        {
          "if": { "properties": { "difficulty": { "const": "easy" } } },
          "then": {
            "required": ["options", "answer"],
            "properties": { "type": { "const": "trueFalse" }, "options": { "const": ["Pravda", "Nepravda"] }, "answer": { "maximum": 1 } },
            "not": { "anyOf": [{ "required": ["acceptedAnswers"] }, { "required": ["year"] }] }
          }
        },
        {
          "if": { "properties": { "difficulty": { "const": "medium" } } },
          "then": {
            "required": ["options", "answer"],
            "properties": { "type": { "const": "choice" }, "options": { "minItems": 4, "maxItems": 4 }, "answer": { "maximum": 3 } },
            "not": { "anyOf": [{ "required": ["acceptedAnswers"] }, { "required": ["year"] }] }
          }
        },
        {
          "if": { "properties": { "difficulty": { "const": "hard" } } },
          "then": {
            "required": ["acceptedAnswers", "year"],
            "properties": { "type": { "const": "text" } },
            "not": { "anyOf": [{ "required": ["options"] }, { "required": ["answer"] }] }
          }
        },
        {
          "if": { "required": ["year"], "properties": { "year": { "const": true } } },
          "then": { "properties": { "acceptedAnswers": { "maxItems": 1, "items": { "type": "string", "pattern": "^[1-9][0-9]{0,3}$" } } } }
        }
      ]
    },
    "mathsStep": {
      "type": "object", "additionalProperties": false, "required": ["prompt", "hint", "answer", "solution"],
      "properties": {
        "prompt": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "solution": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/mathsAnswer" },
        "assessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "progressiveMathsExercise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "difficulty", "type", "prompt", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "icon": { "$ref": "#/$defs/icon" },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "type": { "enum": ["trueFalse", "choice", "number"] },
        "prompt": { "$ref": "#/$defs/text" },
        "hint": { "$ref": "#/$defs/text" },
        "solution": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "options": { "type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "answer": { "type": "integer", "minimum": 0, "maximum": 5 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mathsStep", "required": ["assessment"],
            "properties": {
              "answer": { "properties": { "format": { "enum": ["integer", "fraction", "decimal"] } } },
              "assessment": { "properties": { "input": { "const": "number" } } }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "difficulty": { "const": "easy" } } },
          "then": { "properties": { "type": { "const": "trueFalse" }, "options": { "const": ["Ano", "Ne"] } } }
        },
        {
          "if": { "properties": { "difficulty": { "const": "medium" } } },
          "then": { "properties": { "type": { "enum": ["choice", "number"] }, "steps": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "difficulty": { "const": "hard" } } },
          "then": { "properties": { "type": { "const": "number" }, "steps": { "minItems": 2, "maxItems": 4 } } }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "required": ["steps"],
            "not": { "anyOf": [
              { "required": ["options"] }, { "required": ["answer"] }, { "required": ["assessment"] },
              { "required": ["hint"] }, { "required": ["solution"] }
            ] }
          },
          "else": {
            "required": ["options", "answer", "assessment", "hint", "solution"],
            "properties": {
              "assessment": {
                "properties": { "input": { "const": "number" }, "exact": { "$ref": "#/$defs/numberMatcher" } },
                "not": { "required": ["partial"] }
              }
            },
            "not": { "required": ["steps"] }
          }
        }
      ]
    },
    "mathsExercise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "difficulty", "prompt", "steps", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "icon": { "$ref": "#/$defs/icon" },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "prompt": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/mathsStep" }
        }
      },
      "allOf": [
        { "if": { "properties": { "difficulty": { "const": "easy" } } }, "then": { "properties": { "steps": { "minItems": 4, "maxItems": 4 } } } },
        { "if": { "properties": { "difficulty": { "const": "medium" } } }, "then": { "properties": { "steps": { "minItems": 1, "maxItems": 1 } } } },
        { "if": { "properties": { "difficulty": { "const": "hard" } } }, "then": { "properties": { "steps": { "minItems": 3, "maxItems": 3 } } } }
      ]
    },
    "mathsAnswer": {
      "type": "object", "additionalProperties": false, "required": ["format"],
      "properties": {
        "format": { "enum": ["integer", "fraction", "decimal", "length"] },
        "value": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?$" },
        "numerator": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]{0,11})$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]{0,11}$" },
        "unit": { "enum": ["mm", "cm", "dm", "m", "km"] }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "fraction" } } },
          "then": {
            "required": ["numerator", "denominator"],
            "not": { "anyOf": [{ "required": ["value"] }, { "required": ["unit"] }] }
          }
        },
        {
          "if": { "properties": { "format": { "enum": ["integer", "decimal", "length"] } } },
          "then": {
            "required": ["value"],
            "not": { "anyOf": [{ "required": ["numerator"] }, { "required": ["denominator"] }] }
          }
        },
        {
          "if": { "properties": { "format": { "const": "integer" } } },
          "then": { "properties": { "value": { "pattern": "^-?(?:0|[1-9][0-9]{0,11})$" } } }
        },
        {
          "if": { "properties": { "format": { "const": "length" } } },
          "then": { "required": ["unit"], "properties": { "value": { "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?$" } } }
        },
        {
          "if": { "properties": { "format": { "enum": ["integer", "decimal"] } } },
          "then": { "not": { "required": ["unit"] } }
        }
      ]
    }
  }
}
